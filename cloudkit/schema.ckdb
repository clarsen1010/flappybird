DEFINE SCHEMA

    RECORD TYPE Player (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        best            INT64 QUERYABLE SORTABLE,
        bestHard        INT64 QUERYABLE SORTABLE,
        bestImpossible  INT64 QUERYABLE SORTABLE,
        bestInsane      INT64 QUERYABLE SORTABLE,
        dayBest         INT64 QUERYABLE SORTABLE,
        dayKey          STRING QUERYABLE SEARCHABLE SORTABLE,
        friends         LIST<STRING> QUERYABLE SEARCHABLE,
        lastPlayed      TIMESTAMP QUERYABLE SORTABLE,
        monthBest       INT64 QUERYABLE SORTABLE,
        monthKey        STRING QUERYABLE SEARCHABLE SORTABLE,
        name            STRING QUERYABLE SEARCHABLE SORTABLE,
        weekBest        INT64 QUERYABLE SORTABLE,
        weekKey         STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
